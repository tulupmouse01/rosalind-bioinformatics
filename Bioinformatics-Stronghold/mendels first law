num = []
with open(r"text.txt") as file:
    for line in file:
        numbers = list(map(int,line.split())) #map can turn things into ints
        num.append(numbers)
        k =num[0][0]
        m = num[0][1]
        n = num[0][2]
total = sum([k,m,n])
total_pairs = (total * (total-1))/2
AA_AA = (k * (k-1))/2
AA_Aa =(k * m)
AA_aa =(k * n)
Aa_Aa = (m * (m - 1)) / 2
Aa_aa = m * n
aa_aa = (n * (n - 1)) / 2
recessive = (Aa_Aa * 0.25) + (Aa_aa * 0.5) + (aa_aa * 1)
probability = 1 - (recessive / total_pairs)
print(probability)






